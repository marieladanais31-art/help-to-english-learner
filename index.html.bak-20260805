<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Help to English Learner — A.C.E. ABCs & PACEs Grade 1</title>
  <meta name="description" content="Interactive learning platform for A.C.E. ABCs with Ace and Christi — phonics, English learners, Grade 1 PACEs, learning guides and supervisor manual." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <!-- ======== NAVIGATION ======== -->
  <nav class="navbar" id="navbar">
    <div class="nav-brand">
      <div class="nav-logo">🌟</div>
      <span class="nav-title">Help to English Learner</span>
    </div>
    <div class="nav-links">
      <button class="nav-btn active" id="nav-home" onclick="showSection('home')">🏠 Home</button>
      <button class="nav-btn" id="nav-abc" onclick="showSection('abc')">🔤 ABCs</button>
      <button class="nav-btn" id="nav-speaking" onclick="showSection('speaking')">🗣️ Speaking English</button>
      <button class="nav-btn" id="nav-word-building" onclick="showSection('word-building')">🔠 Word Building</button>
      <button class="nav-btn" id="nav-animal-science" onclick="showSection('animal-science')">🐾 Animal Science</button>
      <button class="nav-btn" id="nav-weekly" onclick="showSection('weekly')">📅 Weekly Guide</button>
      <button class="nav-btn" id="nav-paces" onclick="showSection('paces')">📚 PACEs+</button>
      <button class="nav-btn" id="nav-supervisor" onclick="showSection('supervisor')">👩‍🏫 Supervisor</button>
      <button class="nav-btn" id="nav-evaluator" onclick="showSection('evaluator')">✅ Evaluator</button>
    </div>
    <button class="hamburger" id="hamburger" onclick="toggleMobileNav()">☰</button>
  </nav>

  <!-- ======== MOBILE NAV ======== -->
  <div class="mobile-nav" id="mobile-nav">
    <button class="mobile-nav-btn" onclick="showSection('home');toggleMobileNav()">🏠 Home</button>
    <button class="mobile-nav-btn" onclick="showSection('abc');toggleMobileNav()">🔤 ABCs</button>
    <button class="mobile-nav-btn" onclick="showSection('speaking');toggleMobileNav()">🗣️ Speaking English</button>
    <button class="mobile-nav-btn" onclick="showSection('word-building');toggleMobileNav()">🔠 Word Building</button>
    <button class="mobile-nav-btn" onclick="showSection('animal-science');toggleMobileNav()">🐾 Animal Science</button>
    <button class="mobile-nav-btn" onclick="showSection('weekly');toggleMobileNav()">📅 Weekly Guide</button>
    <button class="mobile-nav-btn" onclick="showSection('paces');toggleMobileNav()">📚 PACEs+</button>
    <button class="mobile-nav-btn" onclick="showSection('supervisor');toggleMobileNav()">👩‍🏫 Supervisor</button>
    <button class="mobile-nav-btn" onclick="showSection('evaluator');toggleMobileNav()">✅ Evaluator</button>
  </div>

  <!-- ======== MAIN CONTENT ======== -->
  <main class="main-content">

    <!-- ==================== HOME ==================== -->
    <section id="section-home" class="section active">
      <div class="hero">
        <div class="hero-bg-circles">
          <div class="circle c1"></div>
          <div class="circle c2"></div>
          <div class="circle c3"></div>
        </div>
        <div class="hero-content">
          <div class="hero-badge">✨ A.C.E. School of Tomorrow</div>
          <h1 class="hero-title">Help to<br/><span class="gradient-text">English Learner</span></h1>
          <p class="hero-subtitle">Interactive platform for <strong>ABCs with Ace & Christi</strong>, English Learner Program, 1st Grade PACEs, Learning Guides and Supervisor Manual.</p>
          <div class="hero-btns">
            <button class="btn-primary" onclick="showSection('abc')">🔤 Start ABCs</button>
            <button class="btn-secondary" onclick="showSection('paces')">📚 Explore PACEs</button>
          </div>
        </div>
        <div class="hero-image">
          <img src="assets/ace_christi_mascots.jpg" alt="Ace and Christi mascots with ABC animals" class="mascot-img" />
        </div>
      </div>

      <!-- Module Cards -->
      <div class="modules-grid">
        <div class="module-card card-abc" onclick="showSection('abc')" role="button" tabindex="0">
          <div class="module-icon">🔤</div>
          <h3>ABCs Program</h3>
          <p>Programa fonético: 26 letras, tarjetas T&K, historias de animales y canciones — 12 semanas</p>
          <div class="module-tag">26 letras · 31 sonidos</div>
        </div>
        <div class="module-card card-speaking" onclick="showSection('speaking')" role="button" tabindex="0">
          <div class="module-icon">🗣️</div>
          <h3>Speaking English</h3>
          <p>Vocabulario real del manual DLC: salón, familia, cuerpo, ropa, comunidad — PACEs 1-12</p>
          <div class="module-tag">12 PACEs · Bilingüe</div>
        </div>
        <div class="module-card card-word-building" onclick="showSection('word-building')" role="button" tabindex="0">
          <div class="module-icon">🔠</div>
          <h3>Word Building</h3>
          <p>Canciones reales del manual: Ape, Antelope, Mule, Sunfish... syllables and words per letter</p>
          <div class="module-tag">12 PACEs · Songs · Para Leer</div>
        </div>
        <div class="module-card card-animal" onclick="showSection('animal-science')" role="button" tabindex="0">
          <div class="module-icon">🐾</div>
          <h3>Animal Science</h3>
          <p>Las criaturas de Dios conectadas a cada letra del ABC — habitats, diets, body coverings</p>
          <div class="module-tag">12 PACEs · Conexión ABC</div>
        </div>
        <div class="module-card card-weekly" onclick="showSection('weekly')" role="button" tabindex="0">
          <div class="module-icon">📅</div>
          <h3>Guía Semanal</h3>
          <p>Horario real Fase 1: Semanas 1-17 con actividades diarias del manual DLC</p>
          <div class="module-tag">Semanas 1–17 · DLC</div>
        </div>
        <div class="module-card card-paces" onclick="showSection('paces')" role="button" tabindex="0">
          <div class="module-icon">📚</div>
          <h3>PACEs Accesorios</h3>
          <p>Math, English, Science, Social Studies — materias complementarias de 1er grado</p>
          <div class="module-tag">PACEs 1001–1012</div>
        </div>
        <div class="module-card card-supervisor" onclick="showSection('supervisor')" role="button" tabindex="0">
          <div class="module-icon">👩‍🏫</div>
          <h3>Manual del Supervisor</h3>
          <p>Bolígrafo rojo, Goal Cards, Cuadro de Estrellas, Centro de Aprendizaje y test de diagnóstico</p>
          <div class="module-tag">Admin · Calificación · Estrellas</div>
        </div>
        <div class="module-card card-evaluator" onclick="showSection('evaluator')" role="button" tabindex="0">
          <div class="module-icon">✅</div>
          <h3>Evaluador</h3>
          <p>Calculadora de puntaje, generador de Goal Cards y Cuadro de Estrellas interactivo</p>
          <div class="module-tag">Calculadora · Estrellas</div>
        </div>
      </div>

      <!-- Quick Stats Banner -->
      <div class="stats-banner">
        <div class="stat"><span class="stat-num">26</span><span class="stat-label">Letras</span></div>
        <div class="stat"><span class="stat-num">17</span><span class="stat-label">Semanas Fase 1</span></div>
        <div class="stat"><span class="stat-num">36</span><span class="stat-label">PACEs ABC Core</span></div>
        <div class="stat"><span class="stat-num">24</span><span class="stat-label">Pistas Audio CD</span></div>
        <div class="stat"><span class="stat-num">80%</span><span class="stat-label">Aprobación</span></div>
        <div class="stat"><span class="stat-num">90%</span><span class="stat-label">Avanzar</span></div>
      </div>
    </section>

    <!-- ==================== ABCs SECTION ==================== -->
    <section id="section-abc" class="section">
      <div class="section-header">
        <h2>🔤 ABCs with Ace & Christi</h2>
        <p>Multi-sensory phonics program — learn all 26 letters and their sounds through animals, songs, and stories</p>
      </div>

      <!-- Filters -->
      <div class="filter-bar">
        <button class="filter-btn active" id="filter-all" onclick="filterPhonics('all', this)">All Sounds</button>
        <button class="filter-btn" id="filter-short-vowel" onclick="filterPhonics('short-vowel', this)">🔵 Short Vowels</button>
        <button class="filter-btn" id="filter-long-vowel" onclick="filterPhonics('long-vowel', this)">🟡 Long Vowels</button>
        <button class="filter-btn" id="filter-consonant" onclick="filterPhonics('consonant', this)">🟢 Consonants</button>
      </div>

      <!-- Week display -->
      <div class="week-info" id="week-info">
        <span>📅 Program runs 12 weeks · 3-4 letters per week · Score 90% to advance</span>
      </div>

      <!-- Phonics Grid -->
      <div class="phonics-grid" id="phonics-grid">
        <!-- populated by JS -->
      </div>

      <!-- Letter Detail Modal -->
      <div class="modal-overlay" id="modal-overlay" onclick="closeModal()">
        <div class="letter-modal" id="letter-modal" onclick="event.stopPropagation()">
          <button class="modal-close" onclick="closeModal()">✕</button>
          <div class="modal-content" id="modal-content"></div>
        </div>
      </div>
    </section>

    <!-- ==================== PACEs SECTION ==================== -->
    <section id="section-paces" class="section">
      <div class="section-header">
        <h2>📚 Grade 1 PACEs (1001–1012)</h2>
        <p>Select a subject to explore the full PACE sequence for 1st Grade</p>
      </div>

      <!-- Subject Selector -->
      <div class="subject-tabs" id="subject-tabs">
        <button class="subject-tab active" style="--color:#4ECDC4" onclick="showSubject('english', this)">
          📝 English
        </button>
        <button class="subject-tab" style="--color:#FF6B6B" onclick="showSubject('math', this)">
          🔢 Math
        </button>
        <button class="subject-tab" style="--color:#A29BFE" onclick="showSubject('wordBuilding', this)">
          🔠 Word Building
        </button>
        <button class="subject-tab" style="--color:#55EFC4" onclick="showSubject('science', this)">
          🔬 Science
        </button>
        <button class="subject-tab" style="--color:#FDCB6E" onclick="showSubject('socialStudies', this)">
          🌎 Social Studies
        </button>
        <button class="subject-tab" style="--color:#E17055" onclick="showSubject('animalScience', this)">
          🐾 Animal Science
        </button>
      </div>

      <!-- PACE List -->
      <div class="pace-list" id="pace-list">
        <!-- populated by JS -->
      </div>
    </section>

    </section>

    <!-- ==================== SUPERVISOR SECTION ==================== -->
    <section id="section-supervisor" class="section">
      <div class="section-header">
        <h2>👩‍🏫 Supervisor Manual</h2>
        <p>Complete guide for supervisors and teachers — scoring, Goal Cards, Star Charts, Learning Center rules</p>
      </div>

      <div class="supervisor-tabs">
        <button class="sup-tab active" onclick="showSupTab('scoring', this)">🖊️ Red Pen Scoring</button>
        <button class="sup-tab" onclick="showSupTab('goalcard', this)">🎯 Goal Cards</button>
        <button class="sup-tab" onclick="showSupTab('learning-center', this)">🏫 Learning Center</button>
        <button class="sup-tab" onclick="showSupTab('character', this)">✝️ Character Traits</button>
        <button class="sup-tab" onclick="showSupTab('placement', this)">📊 Placement Test</button>
      </div>

      <div class="supervisor-content" id="supervisor-content">
        <!-- populated by JS -->
      </div>
    </section>

    <!-- ==================== EVALUATOR SECTION ==================== -->
    <section id="section-evaluator" class="section">
      <div class="section-header">
        <h2>✅ Score Evaluator & Tracker</h2>
        <p>Calculate scores, track progress, generate Goal Cards and manage Star Charts</p>
      </div>

      <div class="evaluator-grid">
        <!-- Score Calculator -->
        <div class="eval-card">
          <h3>🧮 Score Calculator</h3>
          <p>Enter the number of correct answers to calculate the percentage score</p>
          <div class="calc-form">
            <div class="calc-row">
              <label>Correct Answers:</label>
              <input type="number" id="calc-correct" min="0" max="100" placeholder="e.g. 18" />
            </div>
            <div class="calc-row">
              <label>Total Questions:</label>
              <input type="number" id="calc-total" min="1" max="100" placeholder="e.g. 20" />
            </div>
            <div class="calc-row">
              <label>Assessment Type:</label>
              <select id="calc-type">
                <option value="checkup">Checkup (pass: 80%)</option>
                <option value="selftest">Self-Test (pass: 80%)</option>
                <option value="posttest">Post Test (pass: 90%)</option>
                <option value="readiness">Readiness Test (pass: 80%)</option>
              </select>
            </div>
            <button class="btn-primary" onclick="calculateScore()">Calculate Score</button>
            <div class="calc-result" id="calc-result" style="display:none"></div>
          </div>
        </div>

        <!-- Goal Card Generator -->
        <div class="eval-card">
          <h3>🎯 Daily Goal Card</h3>
          <p>Generate a printable Goal Card for the student's daily work plan</p>
          <div class="goal-form">
            <input type="text" id="goal-student-name" placeholder="Student Name" />
            <input type="date" id="goal-date" />
            <div id="goal-subjects">
              <div class="goal-subject-row" data-subject="English">
                <span>📝 English PACE:</span>
                <input type="text" placeholder="Page goal (e.g. pp. 5-8)" />
              </div>
              <div class="goal-subject-row" data-subject="Math">
                <span>🔢 Math PACE:</span>
                <input type="text" placeholder="Page goal (e.g. pp. 3-5)" />
              </div>
              <div class="goal-subject-row" data-subject="Word Building">
                <span>🔠 Word Building:</span>
                <input type="text" placeholder="Page goal" />
              </div>
              <div class="goal-subject-row" data-subject="Science">
                <span>🔬 Science PACE:</span>
                <input type="text" placeholder="Page goal" />
              </div>
            </div>
            <button class="btn-primary" onclick="generateGoalCard()">📄 Preview Goal Card</button>
          </div>
        </div>

        <!-- Star Chart -->
        <div class="eval-card eval-card-full">
          <h3>⭐ Star Chart</h3>
          <p>Track student achievement with the interactive Star Chart. Click to award or remove stars.</p>
          <div class="star-chart-header">
            <input type="text" id="star-student-name" placeholder="Student Name" class="star-name-input" />
            <button class="btn-secondary" onclick="resetStars()">↺ Reset</button>
            <button class="btn-primary" onclick="printStarChart()">🖨️ Print</button>
          </div>
          <div class="star-chart" id="star-chart">
            <!-- populated by JS -->
          </div>
          <div class="star-total" id="star-total">⭐ Total Stars: 0</div>
        </div>
      </div>

      <!-- Goal Card Preview Modal -->
      <div class="modal-overlay" id="goal-modal-overlay" onclick="closeGoalModal()" style="display:none">
        <div class="goal-card-modal" id="goal-card-modal" onclick="event.stopPropagation()">
          <button class="modal-close" onclick="closeGoalModal()">✕</button>
          <div id="goal-card-preview"></div>
          <div style="text-align:center;margin-top:1.5rem">
            <button class="btn-primary" onclick="window.print()">🖨️ Print Goal Card</button>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SPEAKING ENGLISH ==================== -->
    <section id="section-speaking" class="section">
      <div class="section-header">
        <h2>🗣️ Speaking English with Ace &amp; Christi</h2>
        <p>Vocabulario real del manual DLC — por Mrs. Elisa Elizondo de Olvera · Semanas 2–5 del Horario Fase 1</p>
      </div>

      <!-- PACE selector -->
      <div class="filter-bar" id="speaking-pace-tabs">
        <!-- populated by JS -->
      </div>

      <div class="speaking-content" id="speaking-content">
        <!-- populated by JS -->
      </div>

      <!-- CD Audio Player -->
      <div class="audio-player-card">
        <h3>🎵 CD — Speaking English with Ace &amp; Christi</h3>
        <p>Selecciona una pista del CD original para escucharla directamente</p>
        <div class="audio-tracks" id="audio-tracks">
          <!-- populated by JS -->
        </div>
        <div id="audio-access-note" style="display:none;margin-top:1rem;padding:0.85rem 1rem;background:rgba(255,211,61,0.08);border:1px solid rgba(255,211,61,0.25);border-radius:var(--radius-sm);font-size:0.85rem;color:var(--text-muted)">
          ⚠️ <strong>No se puede reproducir desde aquí.</strong> Safari bloquea archivos locales por seguridad.<br/>
          Solución: Abre la carpeta del CD directamente en Finder o usa un navegador como Chrome con el flag <code>--allow-file-access-from-files</code>.<br/>
          <a href="file:///Users/marielaandrade/Documents/ABC%20For%20English%20Learner%20-%20DLC/CD%20-%20Speaking%20English%20With%20Ace%20and%20Christi/" style="color:var(--accent);margin-top:0.5rem;display:inline-block">📁 Abrir carpeta del CD en Finder →</a>
        </div>
      </div>
    </section>

    <!-- ==================== WORD BUILDING ==================== -->
    <section id="section-word-building" class="section">
      <div class="section-header">
        <h2>🔠 Word Building — Letras del ABC</h2>
        <p>Canciones reales, animales mascota, vocabulario y sílabas "Para Leer" de cada PACE</p>
      </div>

      <div class="filter-bar" id="wb-pace-tabs">
        <!-- populated by JS -->
      </div>

      <div class="wb-content" id="wb-content">
        <!-- populated by JS -->
      </div>
    </section>

    <!-- ==================== ANIMAL SCIENCE ==================== -->
    <section id="section-animal-science" class="section">
      <div class="section-header">
        <h2>🐾 Animal Science — Las Criaturas de Dios</h2>
        <p>Cada PACE de Animal Science está conectado con las letras y animales del programa ABC</p>
      </div>

      <div class="filter-bar" id="as-pace-tabs">
        <!-- populated by JS -->
      </div>

      <div class="as-content" id="as-content">
        <!-- populated by JS -->
      </div>
    </section>

    <!-- ==================== WEEKLY GUIDE ==================== -->
    <section id="section-weekly" class="section">
      <div class="section-header">
        <h2>📅 Guía Semanal — Horario Fase 1</h2>
        <p>Plan diario real basado en el manual DLC · Semanas 1–17</p>
      </div>

      <div class="filter-bar" id="weekly-tabs">
        <button class="filter-btn active" onclick="showWeek('week1', this)">Semana 1</button>
        <button class="filter-btn" onclick="showWeek('week2_4', this)">Semanas 2–4</button>
        <button class="filter-btn" onclick="showWeek('week5', this)">Semana 5</button>
        <button class="filter-btn" onclick="showWeek('week6_17', this)">Semanas 6–17</button>
      </div>

      <div class="weekly-content" id="weekly-content">
        <!-- populated by JS -->
      </div>
    </section>

  </main>

  <!-- ======== FOOTER ======== -->
  <footer class="footer">
    <p>🌟 Help to English Learner — Built on <strong>A.C.E. School of Tomorrow</strong> methodology | ABCs with Ace & Christi · Grade 1 PACEs</p>
    <p style="opacity:0.6;font-size:0.8rem;margin-top:0.5rem">Curriculum based on A.C.E. Accelerated Christian Education · Educational use</p>
  </footer>

  <!-- ======== SCRIPTS ======== -->
  <script src="data/abc_phonics_data.js"></script>
  <script src="data/paces_grade1_data.js"></script>
  <script src="data/dlc_curriculum_data.js"></script>
  <script src="app.js"></script>
</body>
</html>
